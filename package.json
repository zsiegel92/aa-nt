{
  "name": "aa-to-nt-app",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.18.2",
  "scripts": {
    "dev": "concurrently \"pnpm run python:dev\" \"pnpm run next:dev\"",
    "next:dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "tsgo-check": "tsgo -p tsconfig.json --noEmit",
    "test": "vitest run",
    "python:dev": "uv run modal serve server.py",
    "python:dev:fastapi": "uv run uvicorn server:webapp --reload --port 8000",
    "python:dump-openapi": "uv run python dump_openapi.py",
    "python:lint": "uv run ruff check .",
    "python:format": "uv run ruff format --check .",
    "python:format:fix": "uv run ruff format .",
    "python:typecheck": "uv run pyright",
    "python:test": "uv run pytest tests/backend",
    "python:check-all": "pnpm run python:typecheck && pnpm run python:lint && pnpm run python:format && pnpm run python:test",
    "gen-client": "pnpm run python:dump-openapi && openapi-ts",
    "check:all": "pnpm run gen-client && pnpm run lint && pnpm run format && pnpm run typecheck && pnpm run tsgo-check && pnpm run test && pnpm run python:check-all && pnpm run build"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@tanstack/react-query": "^5.90.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.562.0",
    "lz-string": "^1.5.0",
    "next": "16.1.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.89.2",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.0",
    "@tailwindcss/postcss": "^4.1.14",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.19.24",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@typescript/native-preview": "7.0.0-dev.20251230.1",
    "@vitest/coverage-v8": "^3.2.4",
    "concurrently": "^9.2.1",
    "eslint": "^9.37.0",
    "eslint-config-next": "16.1.1",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
